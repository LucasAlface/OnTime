    "id": "table.User",
    "label": "Create table \"User\"",
    "summary": "Creates table \"User\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "User"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"User\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"User\""
        ],
        "expectation": {
          "expects": "absent",
          "object": "table \"User\""
        }
      }
    ],
    "execute": [
      {
        "description": "create table \"User\"",
        "sql": "CREATE TABLE \"public\".\"User\" (\n  \"createdAt\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"email\" text NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"name\" text,\n  \"passwordHash\" text NOT NULL,\n  \"updatedAt\" timestamptz(3) NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"User\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_class\" AS \"c\" WHERE (\"c\".\"oid\" = to_regclass($1) AND (\"c\".\"relkind\" = $2 OR \"c\".\"relkind\" = $3))) AS \"result\"",
        "params": [
          "\"public\".\"User\"",
          "r",
          "p"
        ],
        "expectation": {
          "expects": "present",
          "object": "table \"User\""
        }
      }
    ]
  },
