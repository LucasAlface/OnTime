// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model SpatialRefSys {
  srid      Int                                     @id(map: "spatial_ref_sys_pkey")
  authName  String(storage: varchar, length: 256)?  @map("auth_name")
  authSrid  Int?                                    @map("auth_srid")
  srtext    String(storage: varchar, length: 2048)?
  proj4text String(storage: varchar, length: 2048)?

  @@check(expression: sql`((srid > 0) AND (srid <= 998999))`, map: "spatial_ref_sys_srid_check")
  @@map("spatial_ref_sys")
}

extension fuzzystrmatch {
}

namespace tiger {
  extension postgis_tiger_geocoder {
  }
}

namespace topology {
  extension postgis_topology {
  }
}

model User {
  id           Int                @id @default(autoincrement())
  email        String             @unique
  name         String?
  passwordHash String
  createdAt    DateTime           @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt
}

model Route {
  line         String             @unique
  name         String?
  sort_order   Int                @unique
  stops        RouteStop[]
  createdAt    DateTime           @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt  
}

model Stop {
  code         String             @unique
  name         String             
  lon          Float
  lat          Float
  routes       RouteStop[]
  createdAt    DateTime           @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt
}

model RouteStop {
  routeLine String
  stopCode  String

  route Route @relation(fields: [routeLine], references: [line], onDelete: Cascade, onUpdate: Cascade)
  stop  Stop  @relation(fields: [stopCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@id([routeLine, stopCode])
}
